# Application
APP_NAME=advancedrocketrydoc
APP_ENV=production
TZ=UTC

# PHP Configuration
PHP_DISPLAY_ERRORS=off
PHP_LOG_ERRORS=on
PHP_ERROR_LOG=/var/log/php-error-advanced-rocketry.log
PHP_MAX_EXECUTION_TIME=30
PHP_MEMORY_LIMIT=128M
PHP_POST_MAX_SIZE=8M
PHP_UPLOAD_MAX_FILESIZE=2M

# Nginx Configuration
NGINX_PORT=8080
NGINX_HOST=127.0.0.1

# Database (if needed in future)
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=advancedrocketry
# DB_USER=user
# DB_PASSWORD=password
